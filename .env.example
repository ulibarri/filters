# Copia este archivo a ".env" (ya está en .gitignore) y ajusta los valores.

# Puerto donde corre la app (web + API)
PORT=3200

# URL pública/base de este servidor, usada para armar los links de descarga
# que se mandan en la tarjeta de Teams (/api/publish). Si no se define, se
# intenta inferir de la request (req.protocol + req.get('host')), pero eso
# falla si hay un proxy/túnel en medio (ngrok, App Service, etc.) — mejor
# definirla explícitamente en producción.
# Ejemplo: API_BASE_URL=https://csv-diff-app.midominio.com
API_BASE_URL=

# Webhook de un flujo de "Workflows" en el canal de MS Teams donde se debe
# publicar el resumen (ver POST /api/publish). Sin esta variable, /api/publish
# responde 501.
TEAMS_WEBHOOK_URL=

# Reservado para cuando se agregue autenticación real a /api (API Key o
# Microsoft Entra ID). Por ahora el middleware no la usa.
API_KEY=
